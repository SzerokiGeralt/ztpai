@page "/products"
@inject ztpai.WebApp.Services.ProductsApiService ProductsApi
@inject ztpai.WebApp.Services.AuthState AuthState

<PageTitle>Produkty</PageTitle>

<h1>Produkty</h1>

@if (products is null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nazwa</th>
                <th>Opis</th>
                <th>Cena</th>
                <th>Na stanie</th>
                @if (AuthState.IsAdmin)
                {
                    <th>Akcje</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                    <td>@product.InStock</td>
                    @if (AuthState.IsAdmin)
                    {
                        <td>
                            <a class="btn btn-sm btn-outline-primary me-2" href="/products/edit/@product.Id">Edytuj</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(product.Id)">Usuń</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@if (AuthState.IsAdmin)
{
    <div class="mt-4">
        <a class="btn btn-primary" href="/products/new">Dodaj produkt</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-3">@message</div>
    }
}

@code {
    private IReadOnlyList<ztpai.WebApp.Models.ProductResponse>? products;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChanged;
        await AuthState.InitializeAsync();
        await LoadAsync();
    }

    private async void HandleAuthChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        products = await ProductsApi.GetProductsAsync();
    }

    private async Task Delete(int id)
    {
        message = null;
        try
        {
            await ProductsApi.DeleteProductAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

}
