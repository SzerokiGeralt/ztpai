@page "/products/edit/{Id:int}"
@inject ztpai.WebApp.Services.ProductsApiService ProductsApi
@inject ztpai.WebApp.Services.AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Edytuj produkt</PageTitle>

<h1>Edytuj produkt</h1>

@if (!AuthState.IsAdmin)
{
    <p>Brak uprawnień.</p>
}
else if (request is null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <EditForm Model="request" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label">Nazwa</label>
            <InputText class="form-control" @bind-Value="request.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Opis</label>
            <InputText class="form-control" @bind-Value="request.Description" />
        </div>
        <div class="mb-3">
            <label class="form-label">Cena</label>
            <InputNumber class="form-control" @bind-Value="request.Price" />
        </div>
        <div class="mb-3">
            <label class="form-label">Na stanie</label>
            <InputNumber class="form-control" @bind-Value="request.InStock" />
        </div>
        <div class="mb-3">
            <label class="form-label">Obrazek</label>
            <InputFile class="form-control" OnChange="HandleFileSelected" accept="image/*" />
            @if (!string.IsNullOrWhiteSpace(request.ImageUrl))
            {
                <div class="form-text">Aktualny plik: @request.ImageUrl</div>
            }
        </div>
        <button class="btn btn-primary" type="submit">Zapisz</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-3">@message</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    private ztpai.WebApp.Models.ProductRequest? request;
    private string? message;
    private IBrowserFile? selectedFile;
    private string? originalImageUrl;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChanged;
        await AuthState.InitializeAsync();
        if (AuthState.IsAdmin)
        {
            var product = await ProductsApi.GetProductAsync(Id);
            if (product is null)
            {
                message = "Nie znaleziono produktu.";
                request = new ztpai.WebApp.Models.ProductRequest();
                return;
            }

            request = new ztpai.WebApp.Models.ProductRequest
            {
                Name = product.Name,
                Description = product.Description,
                Price = product.Price,
                InStock = product.InStock,
                ImageUrl = product.ImageUrl
            };
            originalImageUrl = product.ImageUrl;
        }
    }

    private async Task Save()
    {
        message = null;
        try
        {
            if (request is null)
            {
                return;
            }

            if (selectedFile is not null)
            {
                var uploadedFileName = await ProductsApi.UploadImageAsync(selectedFile);
                request.ImageUrl = uploadedFileName;

                if (!string.IsNullOrWhiteSpace(originalImageUrl) &&
                    !string.Equals(originalImageUrl, uploadedFileName, StringComparison.OrdinalIgnoreCase))
                {
                    await ProductsApi.DeleteImageAsync(originalImageUrl);
                }
            }

            await ProductsApi.UpdateProductAsync(Id, request);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
