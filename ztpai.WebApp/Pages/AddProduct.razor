@page "/products/new"
@inject ztpai.WebApp.Services.ProductsApiService ProductsApi
@inject ztpai.WebApp.Services.AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Dodaj produkt</PageTitle>

<h1>Dodaj produkt</h1>

@if (!AuthState.IsAdmin)
{
    <p>Brak uprawnień.</p>
}
else
{
    <EditForm Model="request" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label">Nazwa</label>
            <InputText class="form-control" @bind-Value="request.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Opis</label>
            <InputText class="form-control" @bind-Value="request.Description" />
        </div>
        <div class="mb-3">
            <label class="form-label">Cena</label>
            <InputNumber class="form-control" @bind-Value="request.Price" />
        </div>
        <div class="mb-3">
            <label class="form-label">Na stanie</label>
            <InputNumber class="form-control" @bind-Value="request.InStock" />
        </div>
        <div class="mb-3">
            <label class="form-label">URL obrazka</label>
            <InputText class="form-control" @bind-Value="request.ImageUrl" />
        </div>
        <button class="btn btn-primary" type="submit">Zapisz</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-3">@message</div>
    }
}

@code {
    private ztpai.WebApp.Models.ProductRequest request = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChanged;
        await AuthState.InitializeAsync();
    }

    private async Task Save()
    {
        message = null;
        try
        {
            await ProductsApi.CreateProductAsync(request);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
