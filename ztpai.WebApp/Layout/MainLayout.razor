@inherits LayoutComponentBase
@inject ztpai.WebApp.Services.AuthState AuthState
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="ms-auto">
                @if (AuthState.IsAuthenticated)
                {
                    <span>Zalogowany jako @AuthState.Username</span>
                    <button class="btn btn-link ms-2" @onclick="Logout">Wyloguj</button>
                }
                else
                {
                    <span>Nie zalogowano</span>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChanged;
        await AuthState.InitializeAsync();
    }

    private async Task Logout()
    {
        await AuthState.ClearAsync();
    }

    private void HandleAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}
